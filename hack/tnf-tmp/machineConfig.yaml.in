apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: master
  name: 200-master-tnf-preparation
spec:
  osImageURL: quay.io/slintes/rhel-coreos:ha
  extensions:
    - two-node-ha
  config:
    ignition:
      version: 3.4.0
    storage:
      files:
        - path: /etc/podman/pull-secret
          mode: 0600
          overwrite: true
          contents:
            compression: ""
            source: data:text/plain;charset=utf-8;base64,${PULL_SECRET}
        - path: /var/lib/pcsd/token
          mode: 0600
          overwrite: false
          contents:
            source: data:text/plain;charset=utf-8,${TOKEN}
    systemd:
      units:
        - name: ha-00-directories.service
          enabled: true
          contents: |
            [Unit]
            Description=Create Directories and Log Files for PCS and Corosync
            After=network.target
            
            [Service]
            Type=oneshot
            ExecStartPre=/bin/mount -o remount,rw /var/
            ExecStart=/bin/mkdir -p /var/lib/pcsd /var/lib/corosync /var/log/pcsd /var/log/cluster
            ExecStartPost=/bin/touch /var/log/pcsd/pcsd.log /var/log/cluster/corosync.log
            ExecStartPost=/bin/chmod 0644 /var/log/pcsd/pcsd.log /var/log/cluster/corosync.log
            RemainAfterExit=yes
            
            [Install]
            WantedBy=multi-user.target
        - name: ha-01-enable-services.service
          enabled: true
          contents: |
            [Unit]
            Description=Enable and start PCSd
            After=ha-00-directories.service
            
            [Service]
            Type=oneshot
            ExecStart=/bin/systemctl enable pcsd.service
            ExecStartPost=/bin/systemctl start pcsd.service
            RemainAfterExit=yes
            
            [Install]
            WantedBy=multi-user.target
        - name: ha-02-auth.service
          enabled: true
          contents: |
            [Unit]
            Description=Auth nodes
            After=ha-01-enable-services.service
            Wants=pcsd.service
            
            [Service]
            Type=oneshot
            ExecStart=/bin/bash -c "/usr/sbin/pcs pcsd accept_token /var/lib/pcsd/token"
            ExecStartPost=/bin/bash -c "/usr/sbin/pcs host auth ${NODE1} addr=${IP1} ${NODE2} addr=${IP2} --token /var/lib/pcsd/token --debug"
            RemainAfterExit=yes
            Restart=on-failure
            RestartSec=10
            StartLimitBurst=3
            
            [Install]
            WantedBy=multi-user.target
